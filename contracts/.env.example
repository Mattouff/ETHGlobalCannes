# Configuration IntentFi - ETHGlobal Cannes 2025

# ===========================================
# CLÉS PRIVÉES (ATTENTION: GARDEZ SECRÈTES!)
# ===========================================
PRIVATE_KEY=your_private_key_here

# ===========================================
# ADRESSES DE CONTRATS DÉPLOYÉS
# ===========================================
INTENTFI_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# ===========================================
# RPC URLs - Obtenez vos clés API sur Alchemy
# ===========================================
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
OPTIMISM_SEPOLIA_RPC_URL=https://opt-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# ===========================================
# CLÉS API ETHERSCAN (pour la vérification)
# ===========================================
ETHERSCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
OPTIMISM_ETHERSCAN_API_KEY=your_optimism_etherscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# ===========================================
# CONFIGURATION FOUNDRY
# ===========================================
FOUNDRY_DISABLE_NIGHTLY_WARNING=true

# ===========================================
# COMMANDES UTILES
# ===========================================

# Déploiement sur Sepolia:
# forge script script/DeployIntentFi.s.sol --rpc-url sepolia --broadcast --verify

# Interaction avec le contrat:
# forge script script/InteractIntentFi.s.sol --rpc-url sepolia --broadcast

# Tests:
# forge test -vvv

# Compilation:
# forge build

